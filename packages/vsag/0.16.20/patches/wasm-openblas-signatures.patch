diff --git a/extern/openblas/fix_wasm_lapack.cmake b/extern/openblas/fix_wasm_lapack.cmake
new file mode 100644
--- /dev/null
+++ b/extern/openblas/fix_wasm_lapack.cmake
@@ -0,0 +1,26 @@
+# OpenBLAS 0.3.34 C LAPACK has inconsistent declarations of some BLAS/LAPACK
+# routines. WebAssembly requires the caller and callee result types to match.
+set(_void_symbols
+    saxpy_ sgemm_ sgemv_ sgeqrf_ sger_ sgesdd_ slacpy_ slarf_
+    slarfg_ slascl_ slassq_ sorgqr_ sscal_ sswap_ strmv_
+)
+set(_int_symbols slarft_ sgetrf_)
+file(GLOB _sources "${OPENBLAS_SOURCE_DIR}/lapack-netlib/SRC/*.c")
+if (NOT _sources)
+    message(FATAL_ERROR "OpenBLAS C LAPACK sources not found")
+endif ()
+foreach (_source IN LISTS _sources)
+    file(READ "${_source}" _original)
+    set(_fixed "${_original}")
+    foreach (_symbol IN LISTS _void_symbols)
+        string(REPLACE "extern /* Subroutine */ int ${_symbol}("
+                       "extern /* Subroutine */ void ${_symbol}(" _fixed "${_fixed}")
+    endforeach ()
+    foreach (_symbol IN LISTS _int_symbols)
+        string(REPLACE "extern /* Subroutine */ void ${_symbol}("
+                       "extern /* Subroutine */ int ${_symbol}(" _fixed "${_fixed}")
+    endforeach ()
+    if (NOT _fixed STREQUAL _original)
+        file(WRITE "${_source}" "${_fixed}")
+    endif ()
+endforeach ()
