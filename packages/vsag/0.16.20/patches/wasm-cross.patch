diff --git a/extern/openblas/openblas.cmake b/extern/openblas/openblas.cmake
index f66fc46..96578b4 100644
--- a/extern/openblas/openblas.cmake
+++ b/extern/openblas/openblas.cmake
@@ -13,12 +13,14 @@ elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
 endif ()
 set(install_dir ${CMAKE_CURRENT_BINARY_DIR}/${name}/install)
 
-if (WIN32 OR APPLE OR ANDROID)
+if (WIN32 OR APPLE OR ANDROID OR EMSCRIPTEN)
     # The upstream Make recipe assumes a GNU host toolchain. Its CMake build
     # supports MSVC and propagates the Android and macOS target settings.
     set(openblas_target ARMV8)
     if (WIN32)
         set(openblas_target CORE2)
+    elseif (EMSCRIPTEN)
+        set(openblas_target WASM128_GENERIC)
     endif ()
     set(openblas_c_flags "${CMAKE_C_FLAGS}")
     if (APPLE OR ANDROID)
@@ -100,7 +102,7 @@ else ()
 endif ()
 
 include_directories(${install_dir}/include)
-if (WIN32 OR APPLE OR ANDROID)
+if (WIN32 OR APPLE OR ANDROID OR EMSCRIPTEN)
     # OpenBLAS CMake installs cblas.h under include/openblas.
     include_directories(${install_dir}/include/openblas)
 endif ()
